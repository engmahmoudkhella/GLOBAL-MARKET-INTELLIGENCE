# Copy to .env and fill in. Never commit .env. All secrets live only on the server.

# --- Database (used by docker-compose) ---
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# --- Application ---
GMI_ENVIRONMENT=production
GMI_LOG_LEVEL=INFO
# Cookies are Secure by default. Set false ONLY for plain-http local development.
GMI_COOKIE_SECURE=true
GMI_SESSION_TTL_HOURS=12
# Trust X-Real-IP from nginx (required for per-IP rate limiting behind the proxy).
GMI_TRUST_PROXY_HEADERS=true
GMI_RATE_LIMIT_LOGIN_PER_MINUTE=10
GMI_RATE_LIMIT_DEFAULT_PER_MINUTE=300
# Display timezone default (storage is always UTC). Decision D8.
GMI_DEFAULT_TIMEZONE=Asia/Gaza

# Host port nginx listens on.
GMI_HTTP_PORT=8080

# --- Live ingestion (Phase 2). Off by default; enable on the VPS after the contract check passes. ---
GMI_INGESTION_ENABLED=false

# --- Provider credentials (Phase 2+). Server-side only; never sent to the browser. ---
GMI_TWELVEDATA_API_KEY=
# Plan limits (defaults = free Basic, development only). Grow $29: 55 and 0 (no daily cap).
GMI_TWELVEDATA_CREDITS_PER_MINUTE=8
GMI_TWELVEDATA_CREDITS_PER_DAY=800
GMI_TWELVEDATA_QUOTE_INTERVAL_SECONDS=60
GMI_TWELVEDATA_CANDLES_1M_INTERVAL_SECONDS=300
# USD/ILS vs Bank of Israel representative-rate cross-check
GMI_BOI_CROSSCHECK_THRESHOLD_PCT=0.5
GMI_BOI_CROSSCHECK_WINDOW_MINUTES=15
GMI_COINGECKO_DEMO_API_KEY=
# --- AI analyst (Phase 6) ---
GMI_ANTHROPIC_API_KEY=
